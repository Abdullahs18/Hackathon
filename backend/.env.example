# Copy to .env inside backend/ for local development. Never commit .env.
DASTAK_DATABASE_URL=postgresql+psycopg://dastak:replace-me@localhost:5432/dastak
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DASTAK_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
DASTAK_CORS_ORIGINS=["http://localhost:5173"]
DASTAK_ACCESS_TOKEN_MINUTES=30
# Used only by the explicit seed command; existing passwords are never reset.
DASTAK_DEMO_PASSWORD=replace-with-a-demo-password
