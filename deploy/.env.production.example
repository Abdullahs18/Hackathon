# Reference only. Enter values in Render's BACKEND environment, never commit real values.
DASTAK_ENVIRONMENT=production
DASTAK_DATABASE_URL=postgresql+psycopg://postgres.PROJECT:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require
DASTAK_JWT_SECRET=GENERATE_A_UNIQUE_SECRET_AT_LEAST_32_CHARACTERS
DASTAK_CORS_ORIGINS=["https://YOUR_FRONTEND.onrender.com"]
DASTAK_STORAGE_BACKEND=supabase
DASTAK_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
DASTAK_SUPABASE_SERVICE_KEY=ENTER_SERVER_ONLY_SECRET_KEY
DASTAK_SUPABASE_BUCKET=dastak-private
DASTAK_DATABASE_POOL_SIZE=3
DASTAK_DATABASE_MAX_OVERFLOW=2
DASTAK_SEED_DEMO=true
DASTAK_DEMO_PASSWORD=CHOOSE_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
GEMINI_API_KEY=ENTER_YOUR_GEMINI_KEY
DASTAK_GEMINI_MODEL=ENTER_YOUR_AVAILABLE_MODEL
# Optional: configure only verified proxy IPs/CIDRs. Never use a wildcard.
DASTAK_TRUSTED_PROXY_IPS=[]
